{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"color": {
			"palette": [
				{ "slug": "bg", "name": "Background", "color": "#0a0e12" },
				{ "slug": "bg-elevated", "name": "Background Elevated", "color": "#10161c" },
				{ "slug": "bg-elevated-2", "name": "Background Elevated 2", "color": "#141c23" },
				{ "slug": "line", "name": "Line", "color": "#1f2c35" },
				{ "slug": "ink", "name": "Ink", "color": "#e2eef2" },
				{ "slug": "ink-dim", "name": "Ink Dim", "color": "#8aa0aa" },
				{ "slug": "ink-faint", "name": "Ink Faint", "color": "#56676f" },
				{ "slug": "accent", "name": "Accent", "color": "#22d3ee" },
				{ "slug": "accent-strong", "name": "Accent Strong", "color": "#0891b2" }
			],
			"custom": true,
			"customDuotone": false
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Fraunces",
					"fontFamily": "Fraunces, Georgia, serif"
				},
				{
					"slug": "body",
					"name": "Inter",
					"fontFamily": "Inter, \"Segoe UI\", sans-serif"
				},
				{
					"slug": "mono",
					"name": "IBM Plex Mono",
					"fontFamily": "\"IBM Plex Mono\", Consolas, monospace"
				}
			],
			"customFontSize": true
		},
		"layout": {
			"contentSize": "640px",
			"wideSize": "1040px"
		},
		"spacing": {
			"units": [ "px", "%", "rem", "vh", "vw" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--bg)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "17px",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" }
			},
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)" }
			}
		}
	}
}
