{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tajwar/work-slider",
	"title": "Work Slider",
	"category": "widgets",
	"description": "Renders published Work Site entries as the responsive 3/2/1-per-view carousel.",
	"textdomain": "tajwar-portfolio",
	"attributes": {
		"perViewDesktop": { "type": "number", "default": 3 },
		"perViewTablet": { "type": "number", "default": 2 },
		"perViewMobile": { "type": "number", "default": 1 }
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
